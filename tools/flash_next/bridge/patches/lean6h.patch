+/**
+ * Phase timers of a launch replayed from an HPU graph (native-replay, 2026-11-21).
+ *
+ * Off unless PT_HPU_HPUGRAPH_REPLAY_TIMING=N (N > 0): then every thread that replays HPU graphs prints, every N
+ * replayed launches, one line "HPUGRAPH_REPLAY_TIMING ..." on stderr with the mean microseconds per launch of each
+ * phase below and the mean number of tensors per launch. Only launches replayed synchronously by
+ * SingleHPUGraph::replayGraph are timed; every other launch path is untouched. A timestamp costs about 20 ns.
+ */
+#pragma once
+#include <sys/syscall.h>
+#include <unistd.h>
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <utility>
+#include <vector>
+
+namespace habana {
+class HabanaLaunchOpPT;
+} // namespace habana
+
+namespace habana::replay_timing {
+
+enum Phase : int {
+  kGraphPrep = 0, // SingleHPUGraph::replayGraph before ExecuteCachedGraph
+  kExecSetup, // ExecuteCachedGraph: the stack, HlExec, set_graph, until hlexec.Launch
+  kLaunchHashes, // HlExec::Launch: symint and permutation hashes, graph index, metadata
+  kCreateLauncher, // HlExec::Launch: CreateLauncher (a new HabanaLaunchOpPT)
+  kRunPrep, // HabanaLaunchOpPT::run: ProcessInputStack, the graph keys, until the spec
+  kRunSpec, // the RecipeArgumentSpec (built, or the cached one)
+  kRunLookup, // TemporaryRecipeStore::Wait, GetCachedRecipe, the hit bookkeeping
+  kRunPatching, // UpdatePatchingInformation
+  kSynCacheConst, // ExecuteSynapseCache: the inference-mode constant scan
+  kLauncherInputs, // RecipeLauncher::Launch: input refs, add_wait_events_on_stream, intermediates
+  kLauncherOutputs, // outputs, external tensor events
+  kSynLaunch, // synapse_helpers::graph::launch
+  kLauncherPost, // recipe counter, producers, resource holder, collective launch
+  kSynCacheTail, // ExecuteSynapseCache after the launch: UpdateRecipeOutputs, ClearStatics
+  kExecBind, // ExecuteCachedGraph after hlexec.Launch: binding the outputs
+  kGraphTail, // SingleHPUGraph::replayGraph after ExecuteCachedGraph
+  kCount
+};
+
+inline const char* const kNames[kCount] = {
+    "graph_prep",
+    "exec_setup",
+    "launch_hashes",
+    "create_launcher",
+    "run_prep",
+    "run_spec",
+    "run_lookup",
+    "run_patching",
+    "syncache_const",
+    "launcher_inputs",
+    "launcher_outputs",
+    "syn_launch",
+    "launcher_post",
+    "syncache_tail",
+    "exec_bind",
+    "graph_tail"};
+
+// Sub-phases inside the phases above (nested, so not added to the phase sum): printed after the tensor counts as
+// "| sub <name> <us> ...", the mean microseconds per launch.
+enum Sub : int {
+  kInRegistry = 0, // launcher_inputs: debug print, profile registry insert, device and stream
+  kInRefs, // launcher_inputs: input and DMA refs and device pointers
+  kInWaits, // launcher_inputs: add_wait_events_on_stream (holds in_future and in_streamwait)
+  kInFuture, // blocked on a collective's future (the HCCL job thread has not issued it yet)
+  kInStreamWait, // event->stream_wait_event: a cross-stream wait enqueued
+  kSynMem, // syn_launch, graph::launch: addresses, tensor-memory total, availability check, workspace shrink
+  kSynWorkspace, // get_workspace_buffer and its logs, log_graph_info
+  kSynLock, // lock_addresses and the address rewrite
+  kSynTrace, // trace copies, the Post-Tensors memory walk, the event handles
+  kSynCall, // synLaunchWithExternalEvents
+  kSynAfter, // after the call until graph::launch returns
+  kPatchAlloc, // run_patching: new outputs and intermediates (create_empty_tensor)
+  kPatchTable, // run_patching: update_patching_table (holds patch_alloc)
+  kPatchInfo, // run_patching: patch_launch_info
+  kPostHolder, // launcher_post: Post-Launch log, recipe counter, external events, resource holder
+  kPostEvents, // launcher_post: producer registration of the outputs
+  kPostRecord, // launcher_post: GenericRecordStream of inputs and outputs (stream allocator)
+  kPostColl, // launcher_post: the collective launch
+  kLeanColl, // inside post_coll: the lean inline issue (lean6), from after prepare_stream to the submitted events
+  kSubCount
+};
+
+inline const char* const kSubNames[kSubCount] = {
+    "in_registry",
+    "in_refs",
+    "in_waits",
+    "in_future",
+    "in_streamwait",
+    "syn_mem",
+    "syn_workspace",
+    "syn_lock",
+    "syn_trace",
+    "syn_call",
+    "syn_after",
+    "patch_alloc",
+    "patch_table",
+    "patch_info",
+    "post_holder",
+    "post_events",
+    "post_record",
+    "post_coll",
+    "lean_coll"};
+
+struct Totals {
+  uint64_t ns[kCount] = {};
+  uint64_t sub_ns[kSubCount] = {};
+  uint64_t launches = 0;
+  uint64_t total_ns = 0;
+  uint64_t reuse_try = 0; // prepared launches that looked at their outputs of two replays ago (lean4)
+  uint64_t reuse_hit = 0; // ... and reused them (every tensor held only by the launcher)
+  uint64_t reuse_poison = 0; // tensors filled with NaN before reuse (PT_HPU_HPUGRAPH_PREPARED_REUSE=2)
+  uint64_t plan_try = 0; // prepared launches that looked at a static plan (lean5)
+  uint64_t plan_hit = 0; // ... and launched from it
+  uint64_t plan_capture = 0; // plans captured after a launch
+  uint64_t plan_bad = 0; // PT_HPU_HPUGRAPH_STATIC_PLAN=2: plans whose addresses no longer translate the same
+  uint64_t inputs = 0;
+  uint64_t intermediates = 0;
+  uint64_t outputs = 0;
+  uint64_t externals = 0;
+};
+
+inline int Interval() {
+  static const int value = [] {
+    const char* env = std::getenv("PT_HPU_HPUGRAPH_REPLAY_TIMING");
+    return env != nullptr ? std::atoi(env) : 0;
+  }();
+  return value;
+}
+
+// PT_HPU_HPUGRAPH_PREPARED_REPLAY=1: a SingleHPUGraph keeps the launcher (HabanaLaunchOpPT) of its first replay and
+// replays later through HabanaLaunchOpPT::RunPrepared: no HlExec, no new launcher, no recipe spec, no recipe lookup.
+inline bool PreparedReplay() {
+  static const bool value = [] {
+    const char* env = std::getenv("PT_HPU_HPUGRAPH_PREPARED_REPLAY");
+    return env != nullptr && std::atoi(env) != 0;
+  }();
+  return value;
+}
+
+// PT_HPU_HPUGRAPH_PREPARED_REUSE (lean4, only with PT_HPU_HPUGRAPH_PREPARED_REPLAY=1): 1 = a prepared launch reuses
+// its output buffers of two replays ago when nothing else holds them; 2 = also fills each reused floating-point
+// buffer with NaN right before the launch (a debug mode: a stale read then shows as NaN, not as a subtle drift).
+inline int PreparedReuse() {
+  static const int value = [] {
+    const char* env = std::getenv("PT_HPU_HPUGRAPH_PREPARED_REUSE");
+    return env != nullptr ? std::atoi(env) : 0;
+  }();
+  return PreparedReplay() ? value : 0;
+}
+
+// PT_HPU_HPUGRAPH_PREPARED_REUSE_MAX_KB (default 4096): a launch whose outputs take more keeps none for reuse, so the
+// extra set of buffers kept per launcher stays small (decode); prefill-sized outputs are never kept.
+inline size_t PreparedReuseMaxBytes() {
+  static const size_t value = [] {
+    const char* env = std::getenv("PT_HPU_HPUGRAPH_PREPARED_REUSE_MAX_KB");
+    return static_cast<size_t>(env != nullptr ? std::atoll(env) : 4096) * 1024;
+  }();
+  return value;
+}
+
+// PT_HPU_HPUGRAPH_STATIC_PLAN (lean5, only with PT_HPU_HPUGRAPH_PREPARED_REUSE >= 1): 1 = a prepared launch whose
+// inputs, kept outputs and kept intermediates are the buffers of its plan (captured two launches ago) launches from
+// the plan's launch info (physical addresses) without patching tables, allocating or translating addresses; 2 = the
+// same, and every planned launch first translates the plan's handles again and counts a mismatch as plan_bad (a
+// verify mode: the plan is dropped and the launch goes the lean4 way).
+inline int StaticPlan() {
+  static const int value = [] {
+    const char* env = std::getenv("PT_HPU_HPUGRAPH_STATIC_PLAN");
+    return env != nullptr ? std::atoi(env) : 0;
+  }();
+  return PreparedReuse() > 0 ? value : 0;
+}
+
+// Debug for the invalidation round: every N-th prepared launch of a thread bumps the defragmentation generation as
+// a defragmentation would (every plan then misses once and is captured again). 0 (default): never.
+inline uint64_t StaticPlanBumpEvery() {
+  static const uint64_t value = [] {
+    const char* env = std::getenv("PT_HPU_HPUGRAPH_STATIC_PLAN_BUMP_EVERY");
+    return static_cast<uint64_t>(env != nullptr ? std::atoll(env) : 0);
+  }();
+  return value;
+}
+
+// PT_HPU_HPUGRAPH_LEAN_COLLECTIVE=1 (lean6): every lazy collective is issued inline on the caller's thread (as with
+// PT_HPU_DISABLE_ASYNC_COLLECTIVE=1), without the copies the job thread needs: no copy of the two tensor infos, no
+// promise and future, no lambda (habana_kernels/hccl_kernels.cpp, collective()).
+inline bool LeanCollective() {
+  static const bool value = [] {
+    const char* env = std::getenv("PT_HPU_HPUGRAPH_LEAN_COLLECTIVE");
+    return env != nullptr && std::atoi(env) != 0;
+  }();
+  return value;
+}
+
+// PT_HPU_H2D_TIMING=N: every N host-to-device copies per thread, one line "HPU_H2D_TIMING ..." on stderr: the copies'
+// mean host microseconds (entry to return, a blocking copy's wait included), the share that blocked
+// (non_blocking=False or no stream-async mode) and their mean wait, the share from pinned memory, the mean bytes and
+// the share issued as one multi-transfer (backend/helpers/tensor_utils.cpp). Off unless set.
+inline int H2DInterval() {
+  static const int value = [] {
+    const char* env = std::getenv("PT_HPU_H2D_TIMING");
+    return env != nullptr ? std::atoi(env) : 0;
+  }();
+  return value;
+}
+
+struct H2DTotals {
+  uint64_t copies = 0;
+  uint64_t host_ns = 0;
+  uint64_t blocking = 0;
+  uint64_t wait_ns = 0;
+  uint64_t pinned = 0;
+  uint64_t bytes = 0;
+  uint64_t multi = 0;
+};
+
+inline H2DTotals& ThreadH2D() {
+  thread_local H2DTotals totals;
+  return totals;
+}
+
+inline void EndH2D(uint64_t host_ns, bool blocking, uint64_t wait_ns, bool pinned, uint64_t bytes, bool multi) {
+  const int interval = H2DInterval();
+  if (interval <= 0) {
+    return;
+  }
+  auto& t = ThreadH2D();
+  t.copies++;
+  t.host_ns += host_ns;
+  t.blocking += blocking ? 1 : 0;
+  t.wait_ns += wait_ns;
+  t.pinned += pinned ? 1 : 0;
+  t.bytes += bytes;
+  t.multi += multi ? 1 : 0;
+  if (t.copies % static_cast<uint64_t>(interval) != 0) {
+    return;
+  }
+  const double n = static_cast<double>(t.copies);
+  char line[512];
+  const int len = std::snprintf(
+      line,
+      sizeof(line),
+      "HPU_H2D_TIMING pid %d tid %ld copies %llu host_us %.2f blocking %.3f wait_us %.2f pinned %.3f bytes %.0f "
+      "multi %.3f\n",
+      static_cast<int>(getpid()),
+      static_cast<long>(syscall(SYS_gettid)),
+      static_cast<unsigned long long>(t.copies),
+      static_cast<double>(t.host_ns) / n / 1000.0,
+      static_cast<double>(t.blocking) / n,
+      t.blocking ? static_cast<double>(t.wait_ns) / static_cast<double>(t.blocking) / 1000.0 : 0.0,
+      static_cast<double>(t.pinned) / n,
+      static_cast<double>(t.bytes) / n,
+      static_cast<double>(t.multi) / n);
+  if (len > 0) {
+    const ssize_t written [[maybe_unused]] =
+        ::write(2, line, std::min(static_cast<size_t>(len), sizeof(line) - 1));
+  }
+  t = H2DTotals{};
+}
+
+// Bumped whenever the device memory's defragmenter runs (backend/synapse_helpers/device_memory.cpp): every static
+// plan holds physical addresses, valid only in the generation it was captured in.
+inline std::atomic<uint64_t>& DefragGeneration() {
+  static std::atomic<uint64_t> generation{0};
+  return generation;
+}
+
+// Set on this thread while a planned launch is in synapse_helpers::graph::launch: the launch info already holds the
+// physical addresses of the plan (graph::launch then neither walks the allocator nor translates). ``generation`` is
+// the defragmentation generation the caller checked; ``handles`` the plan's untranslated addresses, one per launch
+// info entry, for the case a defragmentation ran between that check and the launch's critical section.
+struct PlannedLaunchState {
+  bool on = false;
+  uint64_t generation = 0;
+  const std::vector<uint64_t>* handles = nullptr;
+  bool late_translation = false; // set by graph::launch when it had to translate the handles after all
+  // constants the inference-mode scan swapped during this planned launch (old handle, new handle): graph::launch
+  // then translates the plan's handles with these replaced (the launch info holds physical addresses, so the
+  // scan's own update cannot find the old entry)
+  std::vector<std::pair<uint64_t, uint64_t>> swapped;
+};
+
+inline PlannedLaunchState& PlannedLaunch() {
+  thread_local PlannedLaunchState state;
+  return state;
+}
+
+struct PlannedLaunchGuard {
+  PlannedLaunchGuard(uint64_t generation, const std::vector<uint64_t>* handles) {
+    auto& s = PlannedLaunch();
+    s.on = true;
+    s.generation = generation;
+    s.handles = handles;
+    s.late_translation = false;
+    s.swapped.clear();
+  }
+  ~PlannedLaunchGuard() {
+    auto& s = PlannedLaunch();
+    s.on = false;
+    s.handles = nullptr;
+  }
+  PlannedLaunchGuard(const PlannedLaunchGuard&) = delete;
+  PlannedLaunchGuard& operator=(const PlannedLaunchGuard&) = delete;
+};
+
+// With PT_HPU_HPUGRAPH_STATIC_PLAN set: the untranslated address of every launch info entry of this thread's last
+// unplanned launch (graph::launch's ``addresses``, 0 for host-to-device entries), for the plan captured after it.
+inline std::vector<uint64_t>& LastLaunchHandles() {
+  thread_local std::vector<uint64_t> handles;
+  return handles;
+}
+
+// The kept launcher of the SingleHPUGraph that SingleHPUGraph::replayGraph is replaying synchronously on this
+// thread (nullptr: the stock launch). Set and cleared by replayGraph around ExecuteCachedGraph.
+inline std::shared_ptr<habana::HabanaLaunchOpPT>*& PreparedSlot() {
+  thread_local std::shared_ptr<habana::HabanaLaunchOpPT>* slot = nullptr;
+  return slot;
+}
+
+// Clears PreparedSlot() when the replayed launch ends, also by an exception.
+struct PreparedSlotGuard {
+  PreparedSlotGuard() = default;
+  ~PreparedSlotGuard() {
+    PreparedSlot() = nullptr;
+  }
+  PreparedSlotGuard(const PreparedSlotGuard&) = delete;
+  PreparedSlotGuard& operator=(const PreparedSlotGuard&) = delete;
+};
+
+inline bool& InReplay() {
+  thread_local bool in_replay = false;
+  return in_replay;
+}
+
+inline Totals& ThreadTotals() {
+  thread_local Totals totals;
+  return totals;
+}
+
+inline bool Active() {
+  return InReplay();
+}
+
+inline uint64_t Now() {
+  return static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(
+          std::chrono::steady_clock::now().time_since_epoch())
+          .count());
+}
+
+// A timestamp inside a replayed launch, 0 elsewhere (so the Add below is a no-op).
+inline uint64_t Stamp() {
+  return Active() ? Now() : 0;
+}
+
+inline void Add(Phase phase, uint64_t t0, uint64_t t1) {
+  if (t0 != 0 && t1 >= t0) {
+    ThreadTotals().ns[phase] += t1 - t0;
+  }
+}
+
+inline void CountReuse(bool hit, uint64_t poisoned) {
+  if (!Active()) {
+    return;
+  }
+  auto& t = ThreadTotals();
+  t.reuse_try++;
+  t.reuse_hit += hit ? 1 : 0;
+  t.reuse_poison += poisoned;
+}
+
+inline void CountPlan(bool tried, bool hit, bool captured, bool bad) {
+  if (!Active()) {
+    return;
+  }
+  auto& t = ThreadTotals();
+  t.plan_try += tried ? 1 : 0;
+  t.plan_hit += hit ? 1 : 0;
+  t.plan_capture += captured ? 1 : 0;
+  t.plan_bad += bad ? 1 : 0;
+}
+
+inline void AddSub(Sub sub, uint64_t t0, uint64_t t1) {
+  if (t0 != 0 && t1 >= t0) {
+    ThreadTotals().sub_ns[sub] += t1 - t0;
+  }
+}
+
+inline void Count(
+    uint64_t inputs,
+    uint64_t intermediates,
+    uint64_t outputs,
+    uint64_t externals) {
+  if (!Active()) {
+    return;
+  }
+  auto& t = ThreadTotals();
+  t.inputs += inputs;
+  t.intermediates += intermediates;
+  t.outputs += outputs;
+  t.externals += externals;
+}
+
+inline void EndLaunch(uint64_t total_ns) {
+  auto& t = ThreadTotals();
+  t.launches++;
+  t.total_ns += total_ns;
+  const int interval = Interval();
+  if (interval <= 0 || t.launches % static_cast<uint64_t>(interval) != 0) {
+    return;
+  }
+  const double n = static_cast<double>(t.launches);
+  // the whole line in one write(2): the ranks of a server share one log
+  char line[2048];
+  size_t len = 0;
+  auto put = [&](int w) {
+    if (w > 0) {
+      len = std::min(sizeof(line) - 1, len + static_cast<size_t>(w));
+    }
+  };
+  put(std::snprintf(
+      line + len,
+      sizeof(line) - len,
+      "HPUGRAPH_REPLAY_TIMING pid %d tid %ld launches %llu total_us %.2f",
+      static_cast<int>(getpid()),
+      static_cast<long>(syscall(SYS_gettid)),
+      static_cast<unsigned long long>(t.launches),
+      static_cast<double>(t.total_ns) / n / 1000.0));
+  for (int i = 0; i < kCount; ++i) {
+    put(std::snprintf(
+        line + len, sizeof(line) - len, " %s %.2f", kNames[i], static_cast<double>(t.ns[i]) / n / 1000.0));
+  }
+  put(std::snprintf(
+      line + len,
+      sizeof(line) - len,
+      " | per launch inputs %.1f intermediates %.1f outputs %.1f externals %.1f reuse_try %.3f reuse_hit %.3f"
+      " reuse_poison %.2f plan_try %.3f plan_hit %.3f plan_capture %.3f plan_bad %.3f defrag_generation %llu | sub",
+      static_cast<double>(t.inputs) / n,
+      static_cast<double>(t.intermediates) / n,
+      static_cast<double>(t.outputs) / n,
+      static_cast<double>(t.externals) / n,
+      static_cast<double>(t.reuse_try) / n,
+      static_cast<double>(t.reuse_hit) / n,
+      static_cast<double>(t.reuse_poison) / n,
+      static_cast<double>(t.plan_try) / n,
+      static_cast<double>(t.plan_hit) / n,
+      static_cast<double>(t.plan_capture) / n,
+      static_cast<double>(t.plan_bad) / n,
+      static_cast<unsigned long long>(DefragGeneration().load())));
+  for (int i = 0; i < kSubCount; ++i) {
+    put(std::snprintf(
+        line + len, sizeof(line) - len, " %s %.2f", kSubNames[i], static_cast<double>(t.sub_ns[i]) / n / 1000.0));
+  }
+  put(std::snprintf(line + len, sizeof(line) - len, "\n"));
+  if (len > 0 && line[len - 1] != '\n') {
+    line[len - 1] = '\n';
+  }
+  const ssize_t written [[maybe_unused]] = ::write(2, line, len);
+  t = Totals();
+}
+
+// One replayed launch: SingleHPUGraph::replayGraph from entry to exit.
+struct ReplayScope {
+  bool on;
+  uint64_t start;
+  ReplayScope() : on(Interval() > 0), start(0) {
+    if (on) {
+      InReplay() = true;
+      start = Now();
+    }
+  }
+  ~ReplayScope() {
+    if (!on) {
+      return;
+    }
+    InReplay() = false;
+    EndLaunch(Now() - start);
+  }
+  ReplayScope(const ReplayScope&) = delete;
+  ReplayScope& operator=(const ReplayScope&) = delete;
+};
+
+} // namespace habana::replay_timing
