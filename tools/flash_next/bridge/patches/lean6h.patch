+void HlExec::LaunchKeep(
+    torch::jit::Stack& stack,
+    const c10::hpu::HPUStream& stream,
+    std::shared_ptr<habana::RecipeArgumentSpec> cached_rarg_psh,
+    std::shared_ptr<habana::HabanaLaunchOpPT>& keep_op) {
+  PT_LAZY_TRACE;
+  namespace rt = habana::replay_timing;
+  const uint64_t rt_l0 = rt::Stamp();
+  PrepareLaunchMeta(stack, stream);
+  const uint64_t rt_l1 = rt::Stamp();
+  rt::Add(rt::kLaunchHashes, rt_l0, rt_l1);
+  auto op = std::make_shared<habana::HabanaLaunchOpPT>(mp_g_and_meta_data_);
+  if (lazyInfo) {
+    op->set_lazy_front_end_info(lazyInfo);
+  }
+  rt::Add(rt::kCreateLauncher, rt_l1, rt::Stamp());
+  try {
+    op->run(stack, cached_rarg_psh, {}, {}, false);
+  } catch (const std::exception& e) {
+    PT_BRIDGE_DEBUG("HabanaLaunchOpPT Run returned exception....\n", e.what());
+    get_habana_lazy_executor().setExecutionMode(LazyExecutionMode::kLAZY);
+    throw;
+  }
+  // kept only after a static recipe-cache hit; otherwise the next replay takes the stock path again
+  keep_op = op->PreparedReady() ? op : nullptr;
+  if (keep_op != nullptr) {
+    keep_op->ReleaseLaunchState();
+  }
+}
