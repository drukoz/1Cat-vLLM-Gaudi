+    auto& cand = reuse_ring_[reuse_turn_];
+    const bool hit = !cand.empty() &&
+        std::all_of(cand.begin(), cand.end(), [](const at::Tensor& t) {
+          return t.defined() && t.use_count() == 1 && t.storage().use_count() == 1;
+        });
