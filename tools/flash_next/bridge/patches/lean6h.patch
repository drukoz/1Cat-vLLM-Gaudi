+
+// PT_HPU_HPUGRAPH_STATIC_PLAN (lean5). A hit needs: the slot's plan valid and from the current defragmentation
+// generation, the same input buffers, the slot's outputs (already checked free by the caller) the plan's, and every
+// kept intermediate held by the plan alone. Then the launch info is the plan's (physical addresses), the tensor
+// infos get the same addresses the unplanned path would patch (without allocating, and with the replay's unchanged
+// shapes), the outputs and in-place outputs are built as update_patching_table builds them, and graph::launch
+// launches without translating (rt::PlannedLaunch). Nothing is changed before the hit is decided.
+bool HabanaLaunchOpPT::TryPlannedLaunch(std::vector<at::Tensor>& cand, int reuse, uint64_t rt_p0) {
+  namespace rt = habana::replay_timing;
+  auto& plan = plans_[reuse_turn_];
+  if (const uint64_t every = rt::StaticPlanBumpEvery(); every > 0 && (++plan_bump_counter_ % every) == 0) {
+    rt::DefragGeneration().fetch_add(1); // debug: as if the defragmenter had run
+  }
+  const uint64_t generation = rt::DefragGeneration().load();
+  bool ok = plan.valid && plan.generation == generation && plan.output_ptrs.size() == cand.size() &&
+      plan.input_ptrs.size() == input_refs_.size() && plan.intermediates != nullptr;
+  for (size_t k = 0; ok && k < cand.size(); ++k) {
+    ok = cand[k].data_ptr() == plan.output_ptrs[k];
+  }
+  for (size_t i = 0; ok && i < input_refs_.size(); ++i) {
+    ok = input_refs_[i].isTensor() && input_refs_[i].toTensor().data_ptr() == plan.input_ptrs[i];
+  }
+  if (ok) {
+    for (const auto& ivp : *plan.intermediates) {
+      const auto& t = ivp->toTensor();
+      if (!t.defined() || t.use_count() != 1) {
+        ok = false;
+        break;
+      }
+    }
+  }
+  bool bad = false;
+  if (ok && rt::StaticPlan() == 2) {
+    // verify: the plan's handles must still translate to the plan's physical addresses
+    auto& device = HPUDeviceContext::get_device();
+    auto lock = device.lock_addresses(plan.handles);
+    for (size_t i = 0; i < plan.launch_info.size(); ++i) {
+      if (lock.at(i) != plan.launch_info[i].pTensorAddress) {
+        bad = true;
+        break;
+      }
+    }
+    if (bad) {
+      ok = false;
+      plan.valid = false;
+    }
+  }
+  rt::CountPlan(true, ok, false, bad);
+  if (!ok) {
+    return false;
+  }
+
+  auto& rvs = *prepared_holder_->rvs_;
+  recipe_launcher_ = prepared_holder_->rl_;
+  uint64_t poisoned = 0;
+  if (reuse == 2) {
+    // debug: NaN into every reused floating-point buffer (outputs and intermediates), right before the launch
+    auto& device = HPUDeviceContext::get_device();
+    auto& stream = device.get_stream(hpu_stream_);
+    auto poison = [&](const at::Tensor& t) {
+      const size_t nbytes = t.storage().nbytes();
+      const auto st = t.scalar_type();
+      if (nbytes == 0 || (st != at::kFloat && st != at::kBFloat16 && st != at::kHalf)) {
+        return;
+      }
+      std::vector<synapse_helpers::device_ptr> ptrs{
+          reinterpret_cast<synapse_helpers::device_ptr>(t.storage().data_ptr().get())};
+      auto lock = device.lock_addresses(ptrs);
+      const uint64_t addr = lock.at(0);
+      synStatus status = synSuccess;
+      if (st == at::kFloat) {
+        status = synMemsetD32Async(addr, 0x7FC00000u, nbytes / 4, stream);
+      } else if (st == at::kBFloat16) {
+        status = synMemsetD16Async(addr, 0x7FC0u, nbytes / 2, stream);
+      } else {
+        status = synMemsetD16Async(addr, 0x7E00u, nbytes / 2, stream);
+      }
+      HABANA_ASSERT(status == synSuccess, "PT_HPU_HPUGRAPH_PREPARED_REUSE=2: the NaN fill failed");
+      ++poisoned;
+    };
+    for (const auto& t : cand) {
+      poison(t);
+    }
+    for (const auto& ivp : *plan.intermediates) {
+      poison(ivp->toTensor());
+    }
+  }
+  rt::CountReuse(true, poisoned);
+  const uint64_t rt_p1 = rt::Stamp();
+  rt::Add(rt::kRunPrep, rt_p0, rt_p1);
+
+  // the tensor infos: the addresses update_patching_table would patch
+  size_t ridx = 0;
+  std::unordered_map<size_t, IValPtrShared> input_parents;
+  const bool need_parents = rvs.num_input_to_outduplicates > 0;
+  for (const auto& input : input_refs_) {
+    const auto& tensor = input.toTensor();
+    auto* tmeta{habana::get_tensor_extra_meta(tensor)};
+    if (tmeta->has_valid_const_id() && tensor.unsafeGetTensorImpl()->storage().nbytes() == 0) {
+      ridx++;
+      continue;
+    }
+    rvs.dtensorinfos.at(ridx)->patch_exact(tensor, false);
+    if (need_parents) {
+      input_parents.emplace(ridx, std::make_shared<IVal>(input));
+    }
+    ridx++;
+  }
+  const size_t induplicates_end = rvs.num_inputs + rvs.num_induplicates;
+  for (; ridx < induplicates_end; ridx++) {
+    auto& ti = *rvs.dtensorinfos.at(ridx);
+    ti.patch(*rvs.dtensorinfos.at(ti.get_parent_index()), false);
+  }
+  const size_t inter_start = rvs.num_inputs + rvs.num_induplicates + rvs.num_dma_inputs + rvs.num_shape_tensors;
+  HABANA_ASSERT(plan.intermediates->size() == rvs.num_intermediates, "static plan: intermediates mismatch");
+  for (size_t k = 0; k < rvs.num_intermediates; ++k) {
+    rvs.dtensorinfos.at(inter_start + k)->patch((*plan.intermediates)[k]->toTensor());
+  }
+  aten_outputs_.resize(rvs.get_aten_output_num());
+  const size_t out_start = inter_start + rvs.num_intermediates;
+  for (size_t k = 0; k < rvs.num_outputs; ++k) {
+    auto& ti = *rvs.dtensorinfos.at(out_start + k);
+    habana_helpers::update_tensor_layout_and_permutation(cand[k], ti);
+    ti.patch(cand[k], false);
+    aten_outputs_.at(ti.get_output_index()) = std::make_shared<IVal>(cand[k]);
+  }
+  size_t dup = out_start + rvs.num_outputs + rvs.num_outduplicates;
+  for (size_t k = 0; k < rvs.num_input_to_outduplicates; ++k, ++dup) {
+    rvs.create_outdup(dup, input_parents, "inputIVpshMap", aten_outputs_, false);
+  }
+  intermediate_tensors_ptr_sh_ = plan.intermediates;
+  syn_launch_info_ = plan.launch_info;
+  rt::Add(rt::kRunPatching, rt_p1, rt::Stamp());
+  {
+    rt::PlannedLaunchGuard guard(generation, &plan.handles);
+    ExecuteSynapseCache();
+    if (rt::PlannedLaunch().late_translation) {
+      plan.valid = false; // a defragmentation ran meanwhile: the launch was translated, the plan is stale
+    }
+  }
+  cand.clear();
+  last_launch_planned_ = true;
+  ReleaseLaunchState();
+  return true;
+}
+
+void HabanaLaunchOpPT::ReleaseLaunchState() {
+  if (habana::replay_timing::PreparedReuse() > 0 && prepared_holder_ != nullptr &&
+      prepared_holder_->rvs_ != nullptr) {
+    // lean4: keep this launch's outputs, in the recipe's output order, for the launch after next
+    const auto& rvs = *prepared_holder_->rvs_;
+    const size_t start = rvs.num_inputs + rvs.num_induplicates + rvs.num_dma_inputs + rvs.num_shape_tensors +
+        rvs.num_intermediates;
+    std::vector<at::Tensor> outs;
+    outs.reserve(rvs.num_outputs);
+    size_t bytes = 0;
+    for (size_t k = 0; k < rvs.num_outputs; ++k) {
+      const size_t idx = rvs.dtensorinfos.at(start + k)->get_output_index();
+      if (idx >= aten_outputs_.size() || !aten_outputs_[idx] || !aten_outputs_[idx]->isTensor()) {
+        outs.clear();
+        break;
