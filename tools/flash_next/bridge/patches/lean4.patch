+    get_habana_lazy_executor().setExecutionMode(LazyExecutionMode::kLAZY);
+    throw;
+  }
+  // kept only after a static recipe-cache hit; otherwise the next replay takes the stock path again
+  keep_op = op->PreparedReady() ? op : nullptr;
+  if (keep_op != nullptr) {
+    keep_op->ReleaseLaunchState();
+  }
+}
