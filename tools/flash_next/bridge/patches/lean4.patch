+void HabanaLaunchOpPT::RunPrepared(torch::jit::Stack& stack) {
+  PT_BRIDGE_BEGIN;
+  namespace rt = habana::replay_timing;
+  const uint64_t rt_p0 = rt::Stamp();
+  HABANA_ASSERT(prepared_holder_ != nullptr, "RunPrepared without a prepared recipe");
+  // the per-launch state that run() fills by appending
+  input_tms_.clear();
+  pt_stack_sh_.clear();
+  syn_launch_info_.clear();
+  external_tensor_info_indexes_.clear();
+  dma_inputs_.clear();
+  aten_outputs_.clear();
+  intermediate_tensors_ptr_sh_ = nullptr;
+  allocated_outputs_ = std::nullopt;
+  ProcessInputStack(stack);
+  if (const int reuse = rt::PreparedReuse(); reuse > 0) {
+    auto& cand = reuse_ring_[reuse_turn_];
+    const bool hit = !cand.empty() &&
+        std::all_of(cand.begin(), cand.end(), [](const at::Tensor& t) {
+          return t.defined() && t.use_count() == 1 && t.storage().use_count() == 1;
+        });
+    uint64_t poisoned = 0;
+    if (hit && reuse == 2) {
+      // debug: NaN into every reused floating-point buffer, on the launch's stream, right before the launch
+      auto& device = HPUDeviceContext::get_device();
+      auto& stream = device.get_stream(hpu_stream_);
+      for (const auto& t : cand) {
+        const size_t nbytes = t.storage().nbytes();
+        const auto st = t.scalar_type();
+        if (nbytes == 0 || (st != at::kFloat && st != at::kBFloat16 && st != at::kHalf)) {
+          continue;
+        }
+        std::vector<synapse_helpers::device_ptr> ptrs{
+            reinterpret_cast<synapse_helpers::device_ptr>(t.storage().data_ptr().get())};
+        auto lock = device.lock_addresses(ptrs);
+        const uint64_t addr = lock.at(0);
+        synStatus status = synSuccess;
+        if (st == at::kFloat) {
+          status = synMemsetD32Async(addr, 0x7FC00000u, nbytes / 4, stream);
+        } else if (st == at::kBFloat16) {
+          status = synMemsetD16Async(addr, 0x7FC0u, nbytes / 2, stream);
+        } else {
+          status = synMemsetD16Async(addr, 0x7E00u, nbytes / 2, stream);
+        }
+        HABANA_ASSERT(status == synSuccess, "PT_HPU_HPUGRAPH_PREPARED_REUSE=2: the NaN fill failed");
+        ++poisoned;
